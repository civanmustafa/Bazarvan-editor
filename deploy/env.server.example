NODE_ENV=production
PORT=8080
EDITOR_PUBLIC_URL=https://editor.example.com

# Public Supabase values used while building the browser app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Provider API credentials are not environment variables. Administrators save
# shared keys and their grants in the dashboard; each user saves their own
# Gemini/OpenAI keys there and no other user can use them.
# This server-only key encrypts every new provider credential in the vault.
AI_SETTINGS_ENCRYPTION_KEY=

# Provider URLs and model names are non-secret runtime configuration.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PAID_MODEL=gemini-2.5-pro
GEMINI_ALLOWED_MODELS=
OPENAI_MODEL=gpt-5.4
OPENAI_ALLOWED_MODELS=gpt-5.4
FIRECRAWL_API_URL=https://api.firecrawl.dev
BROWSERLESS_API_URL=https://production-sfo.browserless.io
# Legacy decryption-only override. Preserve an existing value until migrated
# crawler rows are verified; do not use it to store a provider API key.
CRAWLER_SETTINGS_ENCRYPTION_KEY=
CLIENT_PAGE_CRAWLER_POLL_MS=2500
CLIENT_PAGE_CRAWLER_IDLE_MAX_MS=30000
CLIENT_PAGE_CRAWLER_LEASE_SECONDS=180
CLIENT_PAGE_CRAWLER_CONCURRENCY=2
CLIENT_PAGE_CRAWLER_TIMEOUT_MS=45000
CLIENT_PAGE_CRAWLER_MAX_BYTES=2500000
CLIENT_PAGE_CRAWLER_RETRY_SECONDS=60
CLIENT_PAGE_CRAWLER_USER_AGENT=BazarvanClientCrawler/1.0 (+https://example.com)
CLIENT_PAGE_CRAWLER_AUTO_MIN_WORDS=40
CLIENT_SITE_CRAWL_API_RATE_LIMIT=30
COMPETITOR_PREVIEW_CACHE_HOURS=24

# Private n8n ingest values.
N8N_INGEST_TOKEN=make-a-long-random-secret-token
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ARTICLE_SAVE_MAX_BYTES=12582912
ARTICLE_SAVE_RATE_LIMIT_PER_MINUTE=120
ARTICLE_IMPORT_TIMEOUT_MS=30000
ARTICLE_IMPORT_MAX_BYTES=4194304

# Durable external-analysis worker. Failed jobs are retried after 30 minutes.
# Engineering prompts cap raw competitor evidence at 30,000 characters total.
EXTERNAL_ANALYSIS_WORKER_POLL_MS=5000
EXTERNAL_ANALYSIS_WORKER_IDLE_MAX_MS=30000
EXTERNAL_ANALYSIS_JOB_LEASE_SECONDS=300
EXTERNAL_ANALYSIS_RETRY_MINUTES=30
EXTERNAL_ANALYSIS_MAX_RETRY_COUNT=5
EXTERNAL_ANALYSIS_WORKER_CONCURRENCY=2
GEMINI_PER_KEY_TIMEOUT_MS=75000
# Maximum cumulative time spent waiting for leased or short-cooldown Gemini keys.
GEMINI_KEY_AVAILABILITY_MAX_WAIT_MS=120000

# Dedicated seven-stage coordinator. It delegates actual AI, Firecrawl, and
# writing work to the specialized workers and keeps only one coordinator active.
FULL_ARTICLE_PIPELINE_WORKER_POLL_MS=5000
FULL_ARTICLE_PIPELINE_WORKER_IDLE_MAX_MS=30000
FULL_ARTICLE_PIPELINE_LEASE_SECONDS=1800

# Dedicated Firecrawl competitor worker. PM2 assigns competitor jobs to it
# separately from Gemini-backed semantic and engineering jobs.
COMPETITOR_WORKER_POLL_MS=3000
COMPETITOR_WORKER_IDLE_MAX_MS=30000
COMPETITOR_WORKER_CONCURRENCY=3

# Durable quick/manual AI commands and structured article writing use the same
# adaptive idle backoff while Realtime provides immediate wake signals.
AI_JOB_WORKER_POLL_MS=1500
AI_JOB_WORKER_IDLE_MAX_MS=30000
CONTENT_WRITING_WORKER_POLL_MS=1500
CONTENT_WRITING_WORKER_IDLE_MAX_MS=30000
