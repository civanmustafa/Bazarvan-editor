VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
EDITOR_PUBLIC_URL=https://editor.example.com

# Provider API credentials are saved only from the authenticated dashboard.
# Administrators save shared credentials and grant them globally or per user;
# each user saves and exclusively uses their own Gemini/OpenAI credentials.
# Do not add Gemini/OpenAI/Firecrawl/Browserless API keys to environment files.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_PAID_MODEL=gemini-2.5-pro
GEMINI_ALLOWED_MODELS=
OPENAI_MODEL=gpt-5.4
OPENAI_ALLOWED_MODELS=gpt-5.4
# 32 random bytes encoded as Base64. Encrypts the canonical provider credential vault.
AI_SETTINGS_ENCRYPTION_KEY=
# Legacy decryption-only override. Keep the existing value until every former
# crawler credential has been verified in the canonical vault; do not rotate it during migration.
CRAWLER_SETTINGS_ENCRYPTION_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev
BROWSERLESS_API_URL=https://production-sfo.browserless.io
COMPETITOR_PREVIEW_CACHE_HOURS=24
N8N_INGEST_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
CLIENT_SITE_CRAWL_API_RATE_LIMIT=30
CLIENT_PAGE_CRAWLER_AUTO_MIN_WORDS=40
# Optional URL article-import limits.
ARTICLE_IMPORT_TIMEOUT_MS=30000
ARTICLE_IMPORT_MAX_BYTES=4194304

# Durable content-writing worker. One concurrent session avoids overlapping long article generations.
CONTENT_WRITING_WORKER_POLL_MS=1500
# Empty queues back off to this interval; Realtime wakes the worker immediately for new work.
CONTENT_WRITING_WORKER_IDLE_MAX_MS=30000
CONTENT_WRITING_SESSION_LEASE_SECONDS=1800
CONTENT_WRITING_WORKER_CONCURRENCY=1
