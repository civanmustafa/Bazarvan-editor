VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# Provider API credentials never belong in Hostinger environment files.
# Save shared credentials as an administrator and personal Gemini/OpenAI
# credentials as the owning user through the authenticated dashboard.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PAID_MODEL=gemini-2.5-pro
GEMINI_ALLOWED_MODELS=
OPENAI_MODEL=gpt-5.4
OPENAI_ALLOWED_MODELS=gpt-5.4
# Canonical credential-vault encryption key. Generate once with: openssl rand -base64 32
AI_SETTINGS_ENCRYPTION_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev
BROWSERLESS_API_URL=https://production-sfo.browserless.io
# Legacy decryption-only override. Preserve an existing value until the vault
# migration is verified; new provider credentials use AI_SETTINGS_ENCRYPTION_KEY.
CRAWLER_SETTINGS_ENCRYPTION_KEY=
COMPETITOR_PREVIEW_CACHE_HOURS=24
N8N_INGEST_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_API_ORIGINS=
API_JSON_LIMIT=12mb
AI_MAX_PROMPT_CHARS=500000
API_AUTH_CACHE_TTL_SECONDS=30
ARTICLE_SAVE_MAX_BYTES=12582912
ARTICLE_SAVE_RATE_LIMIT_PER_MINUTE=120
ARTICLE_IMPORT_TIMEOUT_MS=30000
ARTICLE_IMPORT_MAX_BYTES=4194304
GEMINI_START_RATE_LIMIT_PER_MINUTE=30
GEMINI_PROGRESS_RATE_LIMIT_PER_MINUTE=600
GEMINI_CANCEL_RATE_LIMIT_PER_MINUTE=30
OPENAI_START_RATE_LIMIT_PER_MINUTE=20
